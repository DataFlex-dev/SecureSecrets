// Tests for cCredentialManager. Uses the real Windows Credential Manager.
// Only the target names below are touched, with session persistence, and they are deleted after every test.

Define TEST_CRED_TARGET        for "DFUnit.SecureSecrets.Target"
Define TEST_CRED_NEW_TARGET    for "DFUnit.SecureSecrets.Renamed"
Define TEST_CRED_FILTER        for "DFUnit.SecureSecrets.*"
Define TEST_ERROR_NOT_FOUND    for 1168 // ERROR_NOT_FOUND from GetLastError

// cCredentialManager that records the events it receives so tests can assert on them.
Class cTestCredentialManager is a cCredentialManager
    Procedure Construct_Object
        Forward Send Construct_Object

        Property Integer piWriteCount 0
        Property Integer piWriteError -1
        Property Integer piDeleteCount 0
        Property Integer piDeleteError -1
        Property Integer piRenameCount 0
        Property Integer piRenameError -1
        Property Integer piReadErrorCount 0
        Property Integer piReadError -1
        Property String psReadErrorMessage ""
    End_Procedure

    Procedure ResetEvents
        Set piWriteCount to 0
        Set piWriteError to -1
        Set piDeleteCount to 0
        Set piDeleteError to -1
        Set piRenameCount to 0
        Set piRenameError to -1
        Set piReadErrorCount to 0
        Set piReadError to -1
        Set psReadErrorMessage to ""
    End_Procedure

    Procedure OnCredentialWrite Integer iError String sErrorMessage
        Set piWriteCount to (piWriteCount (Self) + 1)
        Set piWriteError to iError
    End_Procedure

    Procedure OnCredentialDelete Integer iError String sErrorMessage
        Set piDeleteCount to (piDeleteCount (Self) + 1)
        Set piDeleteError to iError
    End_Procedure

    Procedure OnCredentialRename Integer iError String sErrorMessage
        Set piRenameCount to (piRenameCount (Self) + 1)
        Set piRenameError to iError
    End_Procedure

    Procedure OnCredentialReadError Integer iError String sErrorMessage
        Set piReadErrorCount to (piReadErrorCount (Self) + 1)
        Set piReadError to iError
        Set psReadErrorMessage to sErrorMessage
    End_Procedure
End_Class

Object oCredentialManagerTests is a cTestFixture
    Set psTestFixtureName to "cCredentialManager"

    Object oManager is a cTestCredentialManager
    End_Object

    Procedure RemoveTestCredentials
        Set psTargetName of oManager to TEST_CRED_NEW_TARGET
        Send DeleteSecret of oManager
        Set psTargetName of oManager to TEST_CRED_TARGET
        Send DeleteSecret of oManager
    End_Procedure

    Procedure Setup
        Send RemoveTestCredentials
        Set pdwPersists of oManager to CRED_PERSIST_SESSION
        Set pdwType of oManager to CRED_TYPE_GENERIC
        Send ResetEvents of oManager
    End_Procedure

    Procedure TearDown
        Send RemoveTestCredentials
    End_Procedure

    // Properties ///////////////////////////////////////////////////

    Object oDefaultsAreGenericAndLocalMachine is a cTest
        Procedure Test
            Handle hoFresh

            Get Create (RefClass (cCredentialManager)) to hoFresh
            Send AssertIAreEqual CRED_TYPE_GENERIC (pdwType (hoFresh)) "Default credential type"
            Send AssertIAreEqual CRED_PERSIST_LOCAL_MACHINE (pdwPersists (hoFresh)) "Default persistence"
            Send AssertSAreEqual "" (psTargetName (hoFresh)) "Default target name"
            Send Destroy of hoFresh
        End_Procedure
    End_Object

    Object oTargetNameRoundTrips is a cTest
        Procedure Test
            Set psTargetName of oManager to "DFUnit.SecureSecrets.SomeName"

            Send AssertSAreEqual "DFUnit.SecureSecrets.SomeName" (psTargetName (oManager))
        End_Procedure
    End_Object

    Object oTargetNameOfMaxAllowedLengthIsAccepted is a cTest
        Procedure Test
            String sName

            Move (Repeat ("x", CRED_MAX_GENERIC_TARGET_NAME_LENGTH - 1)) to sName
            Set psTargetName of oManager to sName

            Send AssertIAreEqual (CRED_MAX_GENERIC_TARGET_NAME_LENGTH - 1) (Length (psTargetName (oManager)))
        End_Procedure
    End_Object

    Object oTooLongTargetNameIsRejectedAndKeepsOldName is a cTest
        Procedure Test
            Set psTargetName of oManager to "DFUnit.SecureSecrets.Keep"

            Send ExpectError DFERR_PROGRAM
            Set psTargetName of oManager to (Repeat ("x", CRED_MAX_GENERIC_TARGET_NAME_LENGTH))
            Send UnExpectError DFERR_PROGRAM

            Send AssertSAreEqual "DFUnit.SecureSecrets.Keep" (psTargetName (oManager)) "Previous name is kept"
        End_Procedure
    End_Object

    // Write / Read /////////////////////////////////////////////////

    Object oWriteThenReadReturnsSecret is a cTest
        Procedure Test
            String sSecret

            Send WriteSecret of oManager "s3cret value"
            Get ReadSecret of oManager to sSecret

            Send AssertIAreEqual 1 (piWriteCount (oManager)) "Write event fired once"
            Send AssertIAreEqual NO_ERROR (piWriteError (oManager)) "Write event reports success"
            Send AssertIAreEqual 0 (piReadErrorCount (oManager)) "No read error"
            Send AssertSAreEqual "s3cret value" sSecret
        End_Procedure
    End_Object

    Object oWriteOverwritesExistingSecret is a cTest
        Procedure Test
            String sSecret

            Send WriteSecret of oManager "first"
            Send WriteSecret of oManager "second"
            Get ReadSecret of oManager to sSecret

            Send AssertSAreEqual "second" sSecret
        End_Procedure
    End_Object

    Object oSecretsAreStoredPerTargetName is a cTest
        Procedure Test
            String sFirst sSecond

            Send WriteSecret of oManager "for first target"
            Set psTargetName of oManager to TEST_CRED_NEW_TARGET
            Send WriteSecret of oManager "for second target"
            Get ReadSecret of oManager to sSecond
            Set psTargetName of oManager to TEST_CRED_TARGET
            Get ReadSecret of oManager to sFirst

            Send AssertSAreEqual "for first target" sFirst
            Send AssertSAreEqual "for second target" sSecond
        End_Procedure
    End_Object

    Object oBinarySecretRoundTripsByteForByte is a cTest
        Procedure Test
            UChar[] ucWritten ucRead
            Integer iIndex

            // Zero and high bytes must survive; they are not representable in every string conversion.
            Move 0 to ucWritten[0]
            Move 1 to ucWritten[1]
            Move 255 to ucWritten[2]
            Move 0 to ucWritten[3]
            Move 128 to ucWritten[4]
            Send WriteUCharArraySecret of oManager ucWritten
            Get ReadUCharArraySecret of oManager to ucRead

            Send AssertIAreEqual NO_ERROR (piWriteError (oManager)) "Write event reports success"
            Send AssertIAreEqual 5 (SizeOfArray (ucRead)) "Secret length"
            If (SizeOfArray (ucRead) = 5) Begin
                For iIndex from 0 to 4
                    Send AssertIAreEqual ucWritten[iIndex] ucRead[iIndex] (SFormat ("Byte %1", iIndex))
                Loop
            End
        End_Procedure
    End_Object

    Object oSecretOfMaxBlobSizeIsAccepted is a cTest
        Procedure Test
            String sSecret

            Send WriteSecret of oManager (Repeat ("A", CRED_MAX_CREDENTIAL_BLOB_SIZE - 1))
            Get ReadSecret of oManager to sSecret

            Send AssertIAreEqual NO_ERROR (piWriteError (oManager)) "Write event reports success"
            Send AssertIAreEqual (CRED_MAX_CREDENTIAL_BLOB_SIZE - 1) (Length (sSecret))
        End_Procedure
    End_Object

    Object oTooLargeSecretIsRejectedWithoutWriting is a cTest
        Procedure Test
            String sSecret

            Send WriteSecret of oManager (Repeat ("A", CRED_MAX_CREDENTIAL_BLOB_SIZE))
            Get ReadSecret of oManager to sSecret

            Send AssertIAreEqual 1 (piWriteCount (oManager)) "Write event fired once"
            Send AssertIAreEqual DFERR_STRING_TOO_LONG (piWriteError (oManager)) "Write event reports too long"
            Send AssertSAreEqual "" sSecret "Nothing was stored"
            Send AssertIAreEqual TEST_ERROR_NOT_FOUND (piReadError (oManager)) "Credential does not exist"
        End_Procedure
    End_Object

    Object oReadingMissingSecretRaisesReadErrorEvent is a cTest
        Procedure Test
            String sSecret

            Get ReadSecret of oManager to sSecret

            Send AssertSAreEqual "" sSecret
            Send AssertIAreEqual 1 (piReadErrorCount (oManager)) "Read error event fired once"
            Send AssertIAreEqual TEST_ERROR_NOT_FOUND (piReadError (oManager)) "ERROR_NOT_FOUND"
            Send AssertSAreNotEqual "" (psReadErrorMessage (oManager)) "Error text is provided"
        End_Procedure
    End_Object

    // Delete ///////////////////////////////////////////////////////

    Object oDeleteRemovesSecret is a cTest
        Procedure Test
            String sSecret

            Send WriteSecret of oManager "to be deleted"
            Send DeleteSecret of oManager
            Get ReadSecret of oManager to sSecret

            Send AssertIAreEqual 1 (piDeleteCount (oManager)) "Delete event fired once"
            Send AssertIAreEqual NO_ERROR (piDeleteError (oManager)) "Delete event reports success"
            Send AssertSAreEqual "" sSecret "Secret is gone"
            Send AssertIAreEqual TEST_ERROR_NOT_FOUND (piReadError (oManager)) "Credential no longer exists"
        End_Procedure
    End_Object

    Object oDeletingMissingSecretReportsNotFound is a cTest
        Procedure Test
            Send DeleteSecret of oManager

            Send AssertIAreEqual 1 (piDeleteCount (oManager)) "Delete event fired once"
            Send AssertIAreEqual TEST_ERROR_NOT_FOUND (piDeleteError (oManager)) "ERROR_NOT_FOUND"
        End_Procedure
    End_Object

    Object oDeleteWithoutTargetNameDoesNothing is a cTest
        Procedure Test
            Set psTargetName of oManager to ""
            Send DeleteSecret of oManager

            Send AssertIAreEqual 0 (piDeleteCount (oManager)) "No event without a target name"
        End_Procedure
    End_Object

    // Enumerate ////////////////////////////////////////////////////

    Object oEnumerateFindsWrittenSecret is a cTest
        Procedure Test
            String[] sNames
            Integer iIndex
            Boolean bFound

            Send WriteSecret of oManager "enumerate me"
            Get EnumerateSecrets of oManager TEST_CRED_FILTER to sNames

            Move False to bFound
            For iIndex from 0 to (SizeOfArray (sNames) - 1)
                If (sNames[iIndex] = TEST_CRED_TARGET) Move True to bFound
            Loop

            Send Assert bFound "Target is part of the enumeration"
        End_Procedure
    End_Object

    Object oEnumerateWithoutMatchReturnsEmptyArray is a cTest
        Procedure Test
            String[] sNames

            Get EnumerateSecrets of oManager "DFUnit.SecureSecrets.NoSuchPrefix.*" to sNames

            Send AssertIAreEqual 0 (SizeOfArray (sNames))
        End_Procedure
    End_Object

    // Rename ///////////////////////////////////////////////////////

    Object oRenameMovesSecretToNewTarget is a cTest
        Procedure Test
            String sOldRead sNewRead

            Send WriteSecret of oManager "moving secret"
            Send RenameSecret of oManager TEST_CRED_NEW_TARGET

            Get ReadSecret of oManager to sOldRead
            Set psTargetName of oManager to TEST_CRED_NEW_TARGET
            Get ReadSecret of oManager to sNewRead

            Send AssertIAreEqual 1 (piRenameCount (oManager)) "Rename event fired once"
            Send AssertIAreEqual NO_ERROR (piRenameError (oManager)) "Rename event reports success"
            Send AssertSAreEqual "" sOldRead "Old target no longer holds the secret"
            Send AssertSAreEqual "moving secret" sNewRead "New target holds the secret"
        End_Procedure
    End_Object

    Object oRenamingMissingSecretReportsError is a cTest
        Procedure Test
            Send RenameSecret of oManager TEST_CRED_NEW_TARGET

            Send AssertIAreEqual 1 (piRenameCount (oManager)) "Rename event fired once"
            Send AssertIAreNotEqual NO_ERROR (piRenameError (oManager)) "Rename event reports failure"
        End_Procedure
    End_Object
End_Object

// Credential protection and user name parsing do not touch the stored credentials.
Object oCredentialProtectionTests is a cTestFixture
    Set psTestFixtureName to "cCredentialManager.Protection"

    Object oManager is a cCredentialManager
    End_Object

    Object oProtectThenUnProtectRestoresValue is a cTest
        Procedure Test
            String sProtected sPlain

            Get ProtectPlainText of oManager "my password" to sProtected
            Get UnProtectValue of oManager sProtected to sPlain

            Send AssertSAreNotEqual "my password" sProtected "Protected value differs from plain text"
            Send AssertSAreEqual "my password" sPlain
        End_Procedure
    End_Object

    Object oProtectedValueIsRecognisedAsProtected is a cTest
        Procedure Test
            String sProtected

            Get ProtectPlainText of oManager "my password" to sProtected

            Send Assert (IsCredentialProtected (oManager, sProtected)) "Protected value is detected"
        End_Procedure
    End_Object

    Object oPlainTextIsNotRecognisedAsProtected is a cTest
        Procedure Test
            Send AssertFalse (IsCredentialProtected (oManager, "my password")) "Plain text is not protected"
        End_Procedure
    End_Object

    Object oParseUserNameSplitsDomainAndUser is a cTest
        Procedure Test
            String[] sParts

            Get ParseUserName of oManager "MYDOMAIN\jsmith" to sParts

            Send AssertIAreEqual 2 (SizeOfArray (sParts)) "User name and domain are returned"
            Send AssertSAreEqual "jsmith" (Trim (sParts[0])) "User name"
            Send AssertSAreEqual "MYDOMAIN" (Trim (sParts[1])) "Domain"
        End_Procedure
    End_Object
End_Object
