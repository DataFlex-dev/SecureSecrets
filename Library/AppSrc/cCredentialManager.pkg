Use AdvApi.h.pkg

Class cCredentialManager is a cObject
    Procedure Construct_Object
        Forward Send Construct_Object

        { Description="Name of the credential manager key" }
        { Visibility=Private }
        Property String private.psTargetName // Made private to check length
        { Description="Username value" }
        Property String psUserName
        { Description="Persistence value" }
        { EnumList="CRED_PERSIST_LOCAL_MACHINE,CRED_PERSIST_NONE,CRED_PERSIST_SESSION,CRED_PERSIST_ENTERPRISE" }
        Property DWord pdwPersists CRED_PERSIST_LOCAL_MACHINE
        { Description="Type value" }
        { EnumList="CRED_TYPE_GENERIC,CRED_TYPE_DOMAIN_PASSWORD,CRED_TYPE_DOMAIN_CERTIFICATE,CRED_TYPE_DOMAIN_VISIBLE_PASSWORD,CRED_TYPE_GENERIC_CERTIFICATE,CRED_TYPE_DOMAIN_EXTENDED,CRED_TYPE_MAXIMUM" }
        Property DWord pdwType CRED_TYPE_GENERIC
    End_Procedure

    { MethodType=Event }
    { Description="Called when the delete of the credential was executed" }
    Procedure OnCredentialDelete Integer iError String sErrorMessage
    End_Procedure

    { MethodType=Event }
    { Description="Called when the read of the credential failed" }
    Procedure OnCredentialReadError Integer iError String sErrorMessage
    End_Procedure

    { MethodType=Event }
    { Description="Called when the rename of the credential was executed" }
    Procedure OnCredentialRename Integer iError String sErrorMessage
    End_Procedure

    { MethodType=Event }
    { Description="Called when the write of the credential was executed" }
    Procedure OnCredentialWrite Integer iError String sErrorMessage
    End_Procedure

    { MethodType=Property }
    Procedure Set psTargetName String sTargetName
        If (Length (sTargetName) < CRED_MAX_GENERIC_TARGET_NAME_LENGTH) Begin
            Set private.psTargetName to sTargetName
        End
        Else Begin
            Error DFERR_PROGRAM "TargetName too long"
        End
    End_Procedure

    { MethodType=Property }
    Function psTargetName Returns String
        String sTargetName

        Get private.psTargetName to sTargetName

        Function_Return sTargetName
    End_Function

    Procedure DeleteSecret
        WString wsTargetName
        DWord dwType
        Boolean bOk

        Get psTargetName to wsTargetName
        If (SizeOfString (wsTargetName) > 0) Begin
            Get pdwType to dwType
            Move (WinAPI_CredDelete (AddressOf (wsTargetName), dwType, 0)) to bOk
            If (not (bOk)) Begin
                Send CheckWindowsError (RefProc (OnCredentialDelete))
            End
            Else Begin
                Send OnCredentialDelete NO_ERROR ""
            End
        End
    End_Procedure

    Function EnumerateSecrets WString wsFilter Returns String[]
        Integer iCount iElement
        Pointer pCredentialsArray pCredential
        tCREDENTIAL CredentialInfo
        Boolean bOk
        Void_Type iVoid
        String[] sCredentials

        Move 0 to iCount
        Move 0 to pCredentialsArray
        Move (WinAPI_CredEnumerate (AddressOf (wsFilter), 0, AddressOf (iCount), AddressOf (pCredentialsArray))) to bOk
        If (bOk) Begin
            If (iCount > 0) Begin
                Decrement iCount
                For iElement from 0 to iCount
                    Move 0 to pCredential
                    Move (MemCopy (AddressOf (pCredential), pCredentialsArray + (iElement * SizeOfType (Pointer)), SizeOfType (Pointer))) to iVoid
                    If (pCredential <> 0) Begin
                        Move (MemCopy (AddressOf (CredentialInfo), pCredential, SizeOfType (tCREDENTIAL))) to iVoid
                        If (CredentialInfo.pszTargetName <> 0) Begin
                            Move (PointerToWString (CredentialInfo.pszTargetName)) to sCredentials[-1]
                        End
                    End
                Loop
            End
            Move (WinAPI_CredFree (pCredentialsArray)) to iVoid
        End

        Function_Return sCredentials
    End_Function

    Function ReadSecret Returns String
        UChar[] ucSecret
        String sSecret

        Get ReadUCharArraySecret to ucSecret
        Move (UCharArrayToString (ucSecret)) to sSecret

        Function_Return sSecret
    End_Function

    Function ReadUCharArraySecret Returns UChar[]
        WString wsTargetName wsErrorMessage
        UChar[] ucSecret
        DWord dwType
        tCREDENTIAL CredentialInfo
        Boolean bOk
        Pointer pCred
        Void_Type iVoid
        Integer iError

        Move 0 to pCred
        Get pdwType to dwType
        Get psTargetName to wsTargetName
        Move (WinAPI_CredRead (AddressOf (wsTargetName), dwType, 0, AddressOf (pCred))) to bOk
        If (bOk) Begin
            Move (MemCopy (AddressOf (CredentialInfo), pCred, SizeOfType(tCREDENTIAL))) to iVoid
            If (CredentialInfo.dwCredentialBlobSize > 0) Begin
                Move (ResizeArray (ucSecret, CredentialInfo.dwCredentialBlobSize)) to ucSecret
                Move (CopyMemory (AddressOf (ucSecret), CredentialInfo.pbCredentialBlob, CredentialInfo.dwCredentialBlobSize)) to iVoid
            End
            Move (WinAPI_CredFree (pCred)) to iVoid
        End
        Else Begin
            Send CheckWindowsError (RefProc (OnCredentialReadError))
        End

        Function_Return ucSecret
    End_Function

    Procedure CheckWindowsError Handle hmEvent
        Integer iChars iError
        WString wsErrorMessage
        Pointer pErrorMessage
        Void_Type iVoid

        Move (GetLastError()) to iError
        If (iError <> NO_ERROR) Begin
            Move 0 to pErrorMessage
            Move (FormatMessageW (FORMAT_MESSAGE_ALLOCATE_BUFFER ior FORMAT_MESSAGE_FROM_SYSTEM ior FORMAT_MESSAGE_IGNORE_INSERTS, 0, iError, 0, AddressOf (pErrorMessage), 0, 0)) to iChars
            If (iChars > 0) Begin
                Move (ZeroString (iChars)) to wsErrorMessage
                Move (CopyMemory (AddressOf (wsErrorMessage), pErrorMessage, iChars * 2)) to iVoid
            End
            If (pErrorMessage > 0) Begin
                Move (Free (pErrorMessage)) to iVoid
            End
        End

        If (Trim (wsErrorMessage) = "") Begin
            Move C_$NoErrorTextAvailable to wsErrorMessage
        End

        Send hmEvent iError wsErrorMessage
    End_Function

    Procedure RenameSecret WString wsNewTargetName
        WString wsOldTargetName wsErrorMessage
        DWord dwType
        Boolean bOk
        tCREDENTIAL CredentialInfo
        Pointer pCred
        Void_Type iVoid

        Get psTargetName to wsOldTargetName
        Get pdwType to dwType
        Move (WinAPI_CredRename (AddressOf (wsOldTargetName), AddressOf (wsNewTargetName), dwType, 0)) to bOk
        If (not (bOk)) Begin
            Move 0 to pCred
            Move (WinAPI_CredRead (AddressOf (wsOldTargetName), dwType, 0, AddressOf (pCred))) to bOk
            If (bOk) Begin
                Move (MemCopy (AddressOf (CredentialInfo), pCred, SizeOfType(tCREDENTIAL))) to iVoid
                Move (AddressOf (wsNewTargetName)) to CredentialInfo.pszTargetName
                Move (WinAPI_CredWrite (AddressOf (CredentialInfo), 0)) to bOk
                If (bOk) Begin
                    Move (WinAPI_CredDelete (AddressOf (wsOldTargetName), dwType, 0)) to bOk
                    If (not (bOk)) Begin
                        Send CheckWindowsError (RefProc (OnCredentialDelete))
                    End
                End
                Move (WinAPI_CredFree (pCred)) to iVoid
            End
        End

        // See if there is a Windows error
        If (not (bOk)) Begin
            Send CheckWindowsError (RefProc (OnCredentialRename))
        End
        Else Begin
            Send OnCredentialRename NO_ERROR ""
        End
    End_Procedure

    { Description="Helper method to write a string secret via a UChar[]" }
    Procedure WriteSecret String sSecret
        UChar[] ucSecret

        Move (StringToUCharArray (sSecret)) to ucSecret
        Send WriteUCharArraySecret ucSecret
    End_Procedure

    Procedure WriteUCharArraySecret UChar[] ucSecret
        WString wsTargetName wsUserName
        tCREDENTIAL CredentialInfo
        Boolean bOk

        If (SizeOfArray (ucSecret) < CRED_MAX_CREDENTIAL_BLOB_SIZE) Begin
            Get pdwType to CredentialInfo.dwType
            Get pdwPersists to CredentialInfo.dwPersist
            Get psTargetName to wsTargetName
            Move (AddressOf (wsTargetName)) to CredentialInfo.pszTargetName
            Get psUsername to wsUserName
            Move (AddressOf (wsUserName)) to CredentialInfo.pszUserName
            Move (SizeOfArray (ucSecret)) to CredentialInfo.dwCredentialBlobSize
            Move (AddressOf (ucSecret)) to CredentialInfo.pbCredentialBlob
            Move (WinAPI_CredWrite (AddressOf (CredentialInfo), 0)) to bOk
            // See if there is a Windows error
            If (not (bOk)) Begin
                Send CheckWindowsError (RefProc (OnCredentialWrite))
            End
            Else Begin
                Send OnCredentialWrite NO_ERROR ""
            End
        End
        Else Begin
            Send OnCredentialWrite DFERR_STRING_TOO_LONG "Credential Secret value too big"
        End
    End_Procedure
    
    Function IsCredentialProtected WString wsValue Returns Boolean
        Boolean bResult
        Integer iProtectionType
        
        // Call API
        Move 0 to iProtectionType
        Move (WinAPI_CredIsProtected (AddressOf (wsValue), AddressOf(iProtectionType))) to bResult
    
        Function_Return (iProtectionType <> CredUnprotected)
    End_Function
    
    Function ProtectPlainText WString wsValue Returns String
        Integer iSizeIn iSizeOut iProtectionType iResult
        WString wsProtectedValue
        
        Move (Length (wsValue)) to iSizeIn
        Move (ZeroString (1)) to wsProtectedValue
        Move 1 to iSizeOut
        Move 0 to iProtectionType
        Move (WinAPI_CredProtect (True, AddressOf (wsValue), iSizeIn, AddressOf (wsProtectedValue), AddressOf (iSizeOut), AddressOf (iProtectionType))) to iResult
        Move (ZeroString (iSizeOut)) to wsProtectedValue
        Move (WinAPI_CredProtect (True, AddressOf (wsValue), iSizeIn, AddressOf (wsProtectedValue), AddressOf (iSizeOut), AddressOf (iProtectionType))) to iResult
        
        Function_Return wsProtectedValue
    End_Function
    
    Function UnProtectValue WString wsProtectedValue Returns String
        Integer iSizeIn iSizeOut iResult
        WString wsUnprotectedValue
        
        Move (Length (wsProtectedValue)) to iSizeIn
        Move (ZeroString (1)) to wsUnprotectedValue
        Move 1 to iSizeOut
        Move (WinAPI_CredUnProtect (True, AddressOf (wsProtectedValue), iSizeIn, AddressOf (wsUnprotectedValue), AddressOf (iSizeOut))) to iResult
        Move (ZeroString (iSizeOut)) to wsUnprotectedValue
        Move (WinAPI_CredUnProtect (True, AddressOf (wsProtectedValue), iSizeIn, AddressOf (wsUnprotectedValue), AddressOf (iSizeOut))) to iResult
        
        Function_Return wsUnprotectedValue
    End_Function
    
    Function ParseUserName WString wsCombinedName Returns String[]
        WString wsUserName wsDomainName
        Integer iRetval
        String[] sResults
        
        Move (ZeroString (CREDUI_MAX_USERNAME_LENGTH)) to wsUserName
        Move wsUserName to wsDomainName

        Move (WinAPI_CredUIParseUserName (AddressOf (wsCombinedName), AddressOf (wsUserName), 256, AddressOf (wsDomainName), 256)) to iRetval
        Move wsUserName to sResults[-1]
        Move wsDomainName to sResults[-1]
        
        Function_Return sResults
    End_Function
End_Class